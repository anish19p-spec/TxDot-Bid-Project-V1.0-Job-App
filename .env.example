# Copy to .env and enter your key locally. Never commit or share .env.
GEMINI_API_KEY=
# Choose a PDF/structured-output-capable model available to your Google account.
GEMINI_MODEL=gemini-3.1-flash-lite

# Gmail email automation. Fill these in your ignored .env, not in this template.
EMAIL_FROM=
EMAIL_TO=
GMAIL_APP_PASSWORD=
